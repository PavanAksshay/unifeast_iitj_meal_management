POSTGRES_DB=iitj_meals
POSTGRES_USER=iitj_local
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://iitj_local:change-this-local-password@db:5432/iitj_meals
TOKEN_SECRET=replace-with-a-long-random-local-secret
STUDENT_DEMO_PASSWORD=demo-student
ADMIN_DEMO_PASSWORD=demo-admin
FINANCE_DEMO_PASSWORD=demo-finance
# Registration email delivery. Add your provider settings in an ignored .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (usually 587) or ssl (usually 465)
SMTP_SECURITY=starttls
# Set true when the site is served over HTTPS.
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3100
